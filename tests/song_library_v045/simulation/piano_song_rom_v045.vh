// Next pitched event AFTER this step; rests are skipped at generation time.
// Invalid/final step returns zero. Separate 7-bit ROM avoids runtime scans.
function [6:0] song_v045_next_note;
    input [1:0] selected;
    input [5:0] step;
    begin
        song_v045_next_note = 7'd0;
        case (selected)
            2'd0: case (step)
                6'd0,6'd12,6'd27,6'd28,6'd40: song_v045_next_note = 7'd60;
                6'd10,6'd11,6'd19,6'd26,6'd38,6'd39: song_v045_next_note = 7'd62;
