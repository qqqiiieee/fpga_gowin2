// Convenience view matching custom score word bit positions (not an uploader):
// [31:24] velocity 96 when valid; [23] next_valid; [22:16] next_note;
// [15] duration>1 beat hint; [14] note onset-quarter; [13] pitched valid;
// [12:7] step (rests count as steps); [6:0] MIDI, zero during rest/count-in/end.
// Call this ONCE per consumer if used: the event/slot helpers are inlined.
function [31:0] song_v045_word;
    input [1:0] selected;
    input [7:0] absolute_quarter;
    reg [7:0] slot;
    reg [18:0] event_data;
    reg [6:0] following;
    reg pitched;
    begin
        slot = song_v045_slot(selected, absolute_quarter);
        event_data = song_v045_event(selected, slot[5:0]);
        following = 7'd0;
        if (selected < 2'd3) begin
            if (absolute_quarter < 8'd8) begin
                event_data = song_v045_event(selected, 6'd0);
                following = event_data[6:0];
            end else if (slot[7])
                following = song_v045_next_note(selected, slot[5:0]);
        end
        pitched = slot[7] && (event_data[6:0] != 7'd0);
        song_v045_word = {pitched ? 8'd96 : 8'd0, (following != 7'd0), following,
            (pitched && event_data[10:7] > 4'd4), (pitched && slot[6]), pitched,
            slot[5:0], pitched ? event_data[6:0] : 7'd0};
    end
endfunction
