IO_LOC "pa_en" R16;
IO_PORT "pa_en" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "hp_din" P15;
IO_PORT "hp_din" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "hp_ws" P16;
IO_PORT "hp_ws" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "hp_bck" N15;
IO_PORT "hp_bck" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "clk" H11;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// V030：四路常开薄膜按键共用GND，内置3.3V上拉，按下为低；不接VCC。
// KEY1切页、KEY2开始/暂停、KEY3重播、KEY4选下一曲。
IO_LOC "ui_buttons_n[0]" A11;
IO_PORT "ui_buttons_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "ui_buttons_n[1]" B11;
IO_PORT "ui_buttons_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "ui_buttons_n[2]" N6;
IO_PORT "ui_buttons_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "ui_buttons_n[3]" D11;
IO_PORT "ui_buttons_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "amp_bck" B14;
IO_PORT "amp_bck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "amp_lrc" A15;
IO_PORT "amp_lrc" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "amp_din" B13;
IO_PORT "amp_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ADS1115, PMOD2 D14/E15, 3.3V open drain, external/module pull-ups.
// 旧MCP3208端口保留但TOUCH_ENABLE默认0；不再作为菜单控制来源。
IO_LOC "touch_sclk" T6;
IO_PORT "touch_sclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "touch_mosi" P6;
IO_PORT "touch_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "touch_miso" R8;
IO_PORT "touch_miso" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "touch_cs_n" T7;
IO_PORT "touch_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
// 专用MIDI接收与两路SEN0503；与调试115200bps USB-UART完全分离。
IO_LOC "midi_rx" T8;
IO_PORT "midi_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "optical_beams[0]" P8;
IO_PORT "optical_beams[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "optical_beams[1]" P9;
IO_PORT "optical_beams[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "adc_scl" D14;
IO_PORT "adc_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "adc_sda" E15;
IO_PORT "adc_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "timbre_led_n[2]" L14;
IO_PORT "timbre_led_n[2]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;

// Dock LED2/LED3/LED5: N16/N14/L16. LED4 above is L14.
// LED0/LED1 (configuration READY/DONE pins) retain their existing functions.
IO_LOC "timbre_led_n[0]" N16;
IO_PORT "timbre_led_n[0]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "timbre_led_n[1]" N14;
IO_PORT "timbre_led_n[1]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "timbre_led_n[3]" L16;
IO_PORT "timbre_led_n[3]" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;

// UART pins verified from the official Sipeed TangPrimer-20K-example README.
IO_LOC "uart_rx" T13;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "uart_tx" M11;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// Tang Primer 20K DOCK onboard HDMI only. Not a PMOD adapter mapping.
// TLVDS pairs follow Sipeed HDMI/src/dk_video.cst. VCCIO=3.3 default Dock.
IO_LOC "tmds_clk_p" G16,H15;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_LOC "tmds_data_p[0]" H14,H16;
IO_PORT "tmds_data_p[0]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_LOC "tmds_data_p[1]" J15,K16;
IO_PORT "tmds_data_p[1]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_LOC "tmds_data_p[2]" K14,K15;
IO_PORT "tmds_data_p[2]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;

// V030: independent ESP32 UART on PMOD3; PMOD1 remains unassigned.
// FPGA L9 RX <- ESP32 TX17; FPGA N8 TX -> ESP32 RX16. FTDI remains T13/M11.
IO_LOC "phone_uart_rx" L9;
IO_PORT "phone_uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "phone_uart_tx" N8;
IO_PORT "phone_uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
